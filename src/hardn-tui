class HardnDashboard(App[None]):
    CSS = APP_CSS
    TITLE = f"HARDN RELOADED  ·  Security Dashboard  ·  v{VERSION}"
    BINDINGS = [
        Binding("r", "refresh_all", "Refresh"),
        Binding("1", "switch_tab('tab-overview')",  "Overview",  show=True),
        Binding("2", "switch_tab('tab-audit')",     "Audit Log", show=True),
        Binding("3", "switch_tab('tab-suricata')",  "Suricata",  show=True),
        Binding("q", "quit", "Quit"),
    ]

    # ── Layout ────────────────────────────────────────────────────────────────

    def compose(self) -> ComposeResult:
        yield Header()
        with Vertical(id="shell"):
            with TabbedContent(id="tabs"):
                # ── Tab 1: Overview ──────────────────────────────────────────
                with TabPane("1 Overview", id="tab-overview"):
                    with Vertical(id="overview-body"):
                        with Horizontal(id="row1"):
                            with Vertical(id="services-panel", classes="panel"):
                                yield Static("[b]SERVICE STATUS[/b]", classes="panel-title")
                                yield DataTable(id="svc-table", show_cursor=False)
                            with Vertical(id="fail2ban-panel", classes="panel"):
                                yield Static("[b]FAIL2BAN — ACTIVE BANS[/b]", classes="panel-title")
                                yield Static("Loading…", id="f2b-content")
                        with Vertical(id="scans-panel", classes="panel"):
                            yield Static("[b]LAST SCAN RESULTS[/b]", classes="panel-title")
                            yield Static("Loading…", id="scans-content")
                # ── Tab 2: Audit Events ──────────────────────────────────────
                with TabPane("2 Audit Events", id="tab-audit"):
                    yield RichLog(id="audit-log", highlight=True, markup=True)
                # ── Tab 3: Suricata Alerts ───────────────────────────────────
                with TabPane("3 Suricata", id="tab-suricata"):
                    yield RichLog(id="suricata-log", highlight=True, markup=True)
            yield Static("", id="status-bar")
        yield Footer()

    def on_mount(self) -> None:
        table = self.query_one("#svc-table", DataTable)
        table.add_column("Service", width=20)
        table.add_column("Status",  width=12)
        self.action_refresh_all()
        self.set_interval(REFRESH_SECS, self.action_refresh_all)

    # ── Tab switching ─────────────────────────────────────────────────────────

    def action_switch_tab(self, tab_id: str) -> None:
        self.query_one("#tabs", TabbedContent).active = tab_id

    # ── Refresh (background thread — never blocks the UI) ─────────────────────

    @work(exclusive=True, thread=True)
    def action_refresh_all(self) -> None:
        self._refresh_services()
        self._refresh_fail2ban()
        self._refresh_scans()
        self._refresh_audit()
        self._refresh_suricata()
        self.call_from_thread(
            self.query_one("#status-bar", Static).update,
            f"Last refresh: {datetime.now().strftime('%H:%M:%S')}  "
            f"· auto-refresh every {REFRESH_SECS}s ·  "
            "[b]1/2/3[/b] tabs  [b]↑↓[/b] scroll  [b]r[/b] refresh  [b]q[/b] quit",
        )

    def _refresh_services(self) -> None:
        rows = fetch_services()
        table = self.query_one("#svc-table", DataTable)
        self.call_from_thread(table.clear)
        for label, state, color in rows:
            self.call_from_thread(table.add_row, label, Text(state, style=color))

    def _refresh_fail2ban(self) -> None:
        jail_rows, banned = fetch_fail2ban()
        parts: list[str] = []
        if jail_rows:
            summary = "  ".join(
                f"[cyan]{j}[/cyan]:[{'red' if n > 0 else 'green'}]{n}[/{'red' if n > 0 else 'green'}]"
                for j, n in jail_rows
            )
            parts.append(summary)
            parts.append("")
        parts.extend(banned)
        self.call_from_thread(
            self.query_one("#f2b-content", Static).update,
            "\n".join(parts),
        )

    def _refresh_scans(self) -> None:
        content = (
            f"[b]ClamAV:[/b]    {fetch_clamav()}\n"
            f"[b]rkhunter:[/b]  {fetch_rkhunter()}\n"
            f"[b]AIDE:[/b]      {fetch_aide()}\n"
            f"[b]Suricata:[/b]  {fetch_suricata_summary()}"
        )
        self.call_from_thread(
            self.query_one("#scans-content", Static).update,
            content,
        )

    def _refresh_audit(self) -> None:
        log = self.query_one("#audit-log", RichLog)
        self.call_from_thread(log.clear)
        for line in fetch_audit_events():
            self.call_from_thread(log.write, line)

    def _refresh_suricata(self) -> None:
        log = self.query_one("#suricata-log", RichLog)
        self.call_from_thread(log.clear)
        for line in fetch_suricata_events():
            self.call_from_thread(log.write, line)


# ── Entry point ───────────────────────────────────────────────────────────────

def main() -> None:
    if "--help" in sys.argv or "-h" in sys.argv:
        print(__doc__)
        sys.exit(0)

    if os.geteuid() != 0:
        print(
            "Warning: not running as root — audit logs and some service data\n"
            "may be inaccessible. Run with: sudo hardn-tui",
            file=sys.stderr,
        )

    HardnDashboard().run()


if __name__ == "__main__":
    main()
